# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (machine-local settings; .claude/settings.json is shared)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Personal data. This repository is PUBLIC.
#
# Genealogy files and the source documents behind this project contain living
# people's birth dates, birthplaces, and family relationships. None of it
# belongs here. Test fixtures must be synthetic or drawn from already-public,
# anonymised material. If you need a real chain to debug against, name the file
# *.local.ts and it will be ignored.
# ---------------------------------------------------------------------------

# Genealogy exports, always personal data
*.ged
*.gedcom
*.GED

# Local scratch: reference PDFs, working notes, real-family fixtures
/reference/
/private/
*.local.ts
*.local.json
